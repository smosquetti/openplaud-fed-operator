# Base URL of the OpenPlaud Kotlin admin API (no trailing slash).
API_BASE_URL=http://localhost:8080/api/v1

# XMPP transport — Strophe over native WebSocket (ejabberd_http_ws on port 5280).
NEXT_PUBLIC_XMPP_WS_URL=ws://localhost:5280/websocket

# XMPP domain and MUC service (room JIDs are <room>@<service>).
NEXT_PUBLIC_XMPP_DOMAIN=localhost
NEXT_PUBLIC_XMPP_SERVICE=conference
